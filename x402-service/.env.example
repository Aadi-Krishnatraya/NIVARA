# NIVARA x402 service configuration (Algorand Testnet)
# Copy to .env and fill in, or run `npm run setup` to generate accounts.

# Algorand address that RECEIVES USDC payments (58-char base32)
AVM_ADDRESS=

# Base64 64-byte private key (32 seed + 32 pubkey) for the CLIENT (buyer) wallet
CLIENT_AVM_PRIVATE_KEY=
# Derived client address (written by setup for reference)
CLIENT_AVM_ADDRESS=

# x402 facilitator (GoPlausible) — verifies and settles payments on-chain
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Resource server port
PORT=4021

# Optional: custom algod/indexer endpoints (default: AlgoNode public)
# ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
# INDEXER_TESTNET_URL=https://testnet-idx.algonode.cloud
